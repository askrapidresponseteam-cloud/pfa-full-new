{
  "name": "pfa-website-vercel",
  "private": true,
  "version": "1.0.0",
  "description": "People for Animals website with server-side CCAvenue payments and Firebase persistence.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --require ./test/_isolate-env.js --test test/*.test.js",
    "audit": "node scripts/audit-site.js",
    "build:search": "node scripts/build-search-index.js && node scripts/build-site-modules.js",
    "build:site-modules": "node scripts/build-site-modules.js",
    "check:site-modules": "node scripts/build-site-modules.js --check",
    "build:seo": "node scripts/build-seo.js",
    "check:seo": "node scripts/build-seo.js --check",
    "build:events": "node scripts/build-events.js",
    "check:events": "node scripts/build-events.js --check",
    "build:newsroom": "node scripts/build-newsroom.js",
    "check:newsroom": "node scripts/build-newsroom.js --check",
    "build:library": "node scripts/build-library.js",
    "check:library": "node scripts/build-library.js --check",
    "media:library": "node scripts/build-library.js --fetch",
    "media:cinekind": "node scripts/fetch-cinekind-media.js",
    "rename:section": "node scripts/rename-section.js",
    "check:media": "node scripts/check-media.js",
    "check:emails": "node scripts/check-emails.js",
    "check:lookalikes": "node scripts/check-lookalikes.js",
    "media:founder": "node scripts/fetch-founder-films.js",
    "media:films": "node scripts/fetch-founder-films.js",
    "audit:laws": "node scripts/audit-laws.js",
    "sync:chrome": "node scripts/sync-chrome.js",
    "check:chrome": "node scripts/sync-chrome.js --check",
    "check:admin": "node scripts/check-admin-setup.js",
    "check:project": "node scripts/firebase-project.js",
    "check:mailbox": "node scripts/check-mailbox.js",
    "build:mobile": "node scripts/mobile-pass.js",
    "check:mobile": "node scripts/mobile-pass.js --check",
    "build:min": "node scripts/minify.js",
    "check:min": "node scripts/minify.js --check",
    "test:tap": "node --require ./test/_isolate-env.js --test --test-reporter=tap test/*.test.js",
    "build:firebase": "node scripts/build-firebase.js",
    "build:firebase:full": "node scripts/build-firebase.js --full",
    "hosting:retention": "node scripts/hosting-retention.js",
    "check:hosting": "node scripts/hosting-retention.js --check",
    "deploy:firebase": "node scripts/build-firebase.js && node scripts/firebase-secrets.js && node scripts/hosting-retention.js && firebase deploy --only functions,hosting,firestore --project pfa-new-website",
    "deploy:storage-rules": "firebase deploy --only storage --project pfa-new-website",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "media:reels": "node scripts/fetch-reel-stills.js",
    "media:units": "node scripts/fetch-unit-photos.js",
    "media:site": "node scripts/fetch-site-photos.js"
  },
  "dependencies": {
    "firebase-admin": "^13.4.0",
    "imapflow": "^1.7.8",
    "mailparser": "^3.9.36",
    "nodemailer": "^7.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "jsdom": "^26.0.0",
    "pdfjs-dist": "^6.3.289",
    "terser": "^5.51.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
