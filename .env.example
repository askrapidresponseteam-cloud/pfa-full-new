# Copy these names into Vercel Project Settings > Environment Variables.
# Never put real values in Git. Use Preview and Production values separately.
CCAVENUE_MERCHANT_ID=
CCAVENUE_ACCESS_CODE=
CCAVENUE_WORKING_KEY=
CCAVENUE_MODE=production

# International (USD) donations, memberships and Give/Send. Required only if
# offering USD. CCAVENUE_USD_MERCHANT_ID is optional - leave unset if CCAvenue
# gave you the same Merchant ID for both currencies, only a different Access
# Code/Working Key. Set it only if CCAvenue issued a fully separate sub-account.
CCAVENUE_USD_MERCHANT_ID=
CCAVENUE_USD_ACCESS_CODE=
CCAVENUE_USD_WORKING_KEY=

# Firebase Admin SDK credentials. Use either the three fields below or
# FIREBASE_SERVICE_ACCOUNT_JSON as one Vercel Secret.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Production: https://peopleforanimalsindia.org
# Preview: set this to the preview URL while testing callbacks.
PUBLIC_SITE_URL=
# PFA Store, the seller's Shopify. Create this token in Shopify's Headless
# sales channel and publish the PFA catalogue products to that channel.
PFA_SHOPIFY_STORE_DOMAIN=sg37v1-ta.myshopify.com
PFA_SHOPIFY_STOREFRONT_API_VERSION=2026-07
PFA_SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Use this instead only if the seller gives PFA a server-side private token.
# PFA_SHOPIFY_STOREFRONT_PRIVATE_ACCESS_TOKEN=

# Live product catalogue shown on store.html (api/paws-catalog.js). Defaults
# shown are already correct for the seller; only override if that changes.
# PAWS_SHOPIFY_DOMAIN=sg37v1-ta.myshopify.com
# PAWS_STOREFRONT_DOMAIN=https://pawsandtails24.com
# Leave unset (strict vegetarian-food filtering) unless PFA explicitly wants
# every food product included regardless of the vegetarian check.
# PAWS_INCLUDE_ALL_FOOD=true
# Brands on the shop come from the seller's own brand collections and are
# detected automatically (lib/store-brands.js). Both of these are optional.
# A comma-separated list of collection handles pins the set exactly, in that
# order; "off" removes the band entirely.
# PAWS_BRAND_COLLECTIONS=farmina,royal-canin,drools
# "off" skips the per-collection product-list fetch (thirty small requests on
# each catalogue refresh) and uses title matching alone.
# PAWS_BRAND_ROSTER=off

# --- Email: every confirmation, receipt, the copy of each submission to PFA's
# inbox, and the replies that come back (owner, 7 Oct 2026) ---
# PFA's own GoDaddy mailbox. Every email is sent as this address over SMTP,
# and replies are read from it over IMAP (lib/inbound-mail.js) and filed on
# the submission they answer. In the mailbox's settings turn on third-party
# email access; with two-step sign-in on, use an app password.
PFA_SMTP_USER=info@peopleforanimalsindia.org
PFA_SMTP_PASS=
# Only if GoDaddy shows other servers for this mailbox (defaults: SMTP
# smtpout.secureserver.net then smtp.titan.email on 465; IMAP imap.titan.email
# then imap.secureserver.net on 993).
# PFA_SMTP_HOST=
# PFA_SMTP_PORT=465
# PFA_IMAP_HOST=
# PFA_IMAP_PORT=993
# Only if replies are read from a different mailbox than the one that sends.
# PFA_IMAP_USER=
# PFA_IMAP_PASS=
# "off" stops the copy to PFA's inbox naming the site's mailbox as a second
# Reply-To; replies then reach the person and are not kept in the panel.
# PFA_CAPTURE_REPLIES=
# Where the copy of every submission goes. Unset means gandhim@exmpls.sansad.in;
# several addresses separated by commas; "off" stops forwarding.
# PFA_SUBMISSIONS_INBOX=
# Called by the schedules (Vercel cron, Cloud Scheduler) that drain the email
# queue and read the mailbox. Any long random string: openssl rand -hex 24
CRON_SECRET=
# Resend, the fallback when no mailbox is set (any provider with Resend's JSON shape)
PFA_MAIL_API_KEY=
PFA_MAIL_FROM="People for Animals <cards@peopleforanimalsindia.org>"
PFA_MAIL_REPLY_TO=
PFA_MAIL_ENDPOINT=https://api.resend.com/emails
# Bearer token for admin shipment updates and running the workers by hand
PFA_ADMIN_TOKEN=

# The seller's store (Shopify)
PFA_SHOPIFY_STORE_DOMAIN=sg37v1-ta.myshopify.com
PFA_SHOPIFY_STOREFRONT_API_VERSION=2026-07
PFA_SHOPIFY_STOREFRONT_ACCESS_TOKEN=
PFA_SHOPIFY_WEBHOOK_SECRET=
PFA_SHOPIFY_ADMIN_TOKEN=

# --- PFA Store: direct payment (Razorpay on the seller's account) ---
# OFF unless this is exactly "1". With it unset the shop behaves as it always
# did: the shopper is handed to the seller's Shopify checkout. Turn it on only
# once every value below is set and the seller has agreed in writing that
# PFA may hold their credentials.
PFA_STORE_DIRECT_PAY=

# The seller's Razorpay keys. The money settles to THEIR account; PFA is not
# the merchant of record. The secret must never reach the browser.
PFA_RAZORPAY_KEY_ID=
PFA_RAZORPAY_KEY_SECRET=
# Razorpay Dashboard > Settings > Webhooks. Subscribe to payment.captured and
# order.paid, pointed at https://<site>/api/webhooks/razorpay
# Without this the webhook refuses everything, and an order whose browser
# closed mid-payment will only be placed by the reconcile cron.
PFA_RAZORPAY_WEBHOOK_SECRET=

# Shopify Admin API token with write_orders, used only to write the paid order.
# Rotate it if it has ever been pasted into a document or a chat.
PFA_SHOPIFY_ADMIN_TOKEN=
# Defaults to PFA_SHOPIFY_STOREFRONT_API_VERSION when unset.
PFA_SHOPIFY_ADMIN_API_VERSION=

# Where Shopify's own notifications are sent instead of to the customer. Must
# be a real mailbox that accepts plus-addressing: each order arrives as
# orders+PFA-ST-XXXXXXXX@... so it can be matched without parsing the body.
PFA_STORE_RELAY_EMAIL=orders@peopleforanimalsindia.org

# The one email the customer receives. Falls back to PFA_MAIL_FROM when unset.
# The sending domain needs SPF, DKIM and DMARC before this is reliable.
PFA_STORE_MAIL_FROM="People for Animals <orders@peopleforanimalsindia.org>"
PFA_STORE_MAIL_REPLY_TO=

# The seller's name, shown on the Razorpay payment sheet because the money
# settles to their account. Nothing in the tree carries it: the page reads it
# from here through the server. Leave it unset and Razorpay shows the
# registered name on the account, which is right by construction.
PFA_SELLER_NAME=

# The order value above which the seller delivers free, so the shop can say how
# much more to add. Must match what is configured in the seller's Shopify
# shipping profile. Unset means the shop says nothing about free delivery.
PFA_FREE_DELIVERY_ABOVE=

# Courier tracking for the shop's Track order panel. The seller's partner
# endpoint answers GET {BASE}/api/partner/orders/{order number} with a bearer
# key that can read shipping status and nothing else. Both unset means the
# tracker shows the stages the store knows itself; set both and the courier
# stages (out for delivery, delivered, live location, ETA) fill in. The key
# never reaches a browser.
PFA_TRACKING_API_BASE=
PFA_TRACKING_API_KEY=

# The courier's own record, through Shiprocket's API: an API user's email and
# password (Shiprocket settings > API > Configure), traded for a token the
# server keeps in memory. With these set, the tracker's last stations - out
# for delivery, delivered, the checkpoint timeline - come from the courier
# itself instead of stopping where Shopify's knowledge stops. Never sent to a
# browser. Unset means the tracker shows the store's and Shopify's stages.
PFA_SHIPROCKET_EMAIL=
PFA_SHIPROCKET_PASSWORD=

# Replies to a forwarded submission come back to the site, which files them
# and carries them on to the person who wrote in (lib/inbound-mail.js). They
# are addressed to PFA_IMAP_USER by default, and a reply is matched to its
# submission by its In-Reply-To and References headers, with the reference in
# the subject as a fallback. Nothing below is needed for that to work.
#
# Set this only if peopleforanimalsindia.org has a catch-all, to give each
# submission its own reply address as a third way to identify it, for a mail
# client that strips headers and edits subject lines. {reference} is replaced
# with the submission's reference, in lower case. Every address made this way
# must reach the mailbox the site reads.
# PFA_REPLY_ADDRESS_PATTERN=app-{reference}@peopleforanimalsindia.org
